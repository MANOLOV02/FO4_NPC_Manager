<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Configurations>Debug;Release;Publish</Configurations>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>FO4_NPC_Manager</RootNamespace>
    <StartupObject>FO4_NPC_Manager.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Identidad que ve el usuario: Propiedades del archivo en Windows y el volcado de ensamblados
       de un reporte de caida. El NUMERO no esta aca: sale del Directory.Build.props del repo. -->
  <PropertyGroup>
    <Product>FO4 NPC Manager</Product>
    <AssemblyTitle>FO4 NPC Manager</AssemblyTitle>
    <Description>NPC editor and FaceGen builder for Fallout 4 and Skyrim SE.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="FO4_Base_Library" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FO4_Base_Library\FO4_Base_Library.vbproj" />
  </ItemGroup>

  <!-- ⛔ LINKEADO, NO REFERENCIADO. CrashReport se compila DENTRO de este exe a proposito: tiene que poder
       reportar que FO4_Base_Library.dll no cargo, y desde adentro de esa lib se caeria con ella. Misma
       fuente que usa Wardrobe_Manager. Ver ..\..\FO4_Base_Library\Shared\CrashReport.vb y Program.Main. -->
  <ItemGroup>
    <Compile Include="..\..\FO4_Base_Library\Shared\CrashReport.vb" Link="CrashReport.vb" />
    <Compile Include="..\..\FO4_Base_Library\Shared\VersionGate.vb" Link="VersionGate.vb" />
  </ItemGroup>

  <!-- El CLI headless (FO4_FaceTint_CLI) llama FaceGenBuilder.BuildCharGen + NpcMaterialResolver
       (Friend) para bakear NIF+texturas sin GUI/GL. Sin cambiar la visibilidad del API interno. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FO4_FaceTint_CLI" />
    <!-- ⛔⛔ RONDA 18 (rev-49, punto 3 del pedido): LOS SEIS IVT QUE NO DECLARABAN QUE APAGAN, MEDIDOS UNO POR UNO.
         El metodo: sacar la linea, compilar SOLO a ese consumidor, y mirar el primer simbolo que el compilador
         rechaza. NINGUNO sobra: los seis son necesarios HOY, y este es el simbolo Friend que cada uno habilita
         (medido el 16-sep, log en fixes\ronda18\logs\ivt_<gate>.log):
           · OclusionRenderGate      -> NpcRenderContext / NpcStateResolver          (Program.vb:326)
           · EstadoAbGate            -> NpcStateResolver / NpcRenderContext          (Program.vb:7536-7537)
           · SidecarIdentifierProbe  -> BssliderSidecar.NormalizeKeys                (Program.vb:83)
           · ContextoPropioGate      -> ArmaEditor_Form.AplicarReferencias/LeerRefs  (Program.vb:311-312)
           · OutfitDraftSaveGate     -> FotosDeBorrador(Of TVista)                   (Program.vb:5266)
           · DetalleDelRecordGate    -> DetalleNodo                                  (Program.vb:441)
         ⛔ LO QUE LOS SEIS APAGAN, que es lo mismo en todos: cada uno deja de ser un testigo PASIVO de que su
         camino se puede ejercer contra la superficie PUBLICA sola. Con el IVT puesto, si manana alguien mueve a
         Friend una clase de ese camino, ese arnes no se entera al construirse. El unico arnes del camino de
         guardado que sigue SIN IVT (y por eso sigue siendo ese testigo) es PresetCargaEstadoMotorGate, mas
         abajo. -->
    <InternalsVisibleTo Include="OclusionRenderGate" />
    <!-- Sonda de medición (Tools/, sólo lectura): ejercita NpcTemplateMaterializer.MakeCategoryOwn REAL
         sobre el load order en vez de reimplementar su lógica. Ver Tools/TemplateMaterializeProbe. -->
    <InternalsVisibleTo Include="TemplateMaterializeProbe" />
    <!-- arq-05: el gate del bucket Traits necesita ProbeCategoryOwn/MakeCategoryOwn, que son
         Friend a proposito. Mismo criterio que TemplateMaterializeProbe: IVT antes que ampliar
         la superficie publica. -->
    <InternalsVisibleTo Include="BucketTraitsGate" />
    <InternalsVisibleTo Include="EstadoAbGate" />
    <!-- ChargenFlagSaveGate: `NpcRecordOverride.MaterializedSources` es un
         `Dictionary(Of ..., NpcTemplateMaterializer.TraitsResolution)` y `TraitsResolution` es Friend, asi
         que sin IVT el arnes no puede ARMAR el fixture "hereda la categoria, la edito, y SI hay snapshot",
         el unico que ejercita el camino feliz del fallo cerrado. Pasaria en vacio, que es peor que rojo.
         Mismo criterio que TemplateMaterializeProbe: IVT antes que ampliar la superficie publica.
         ⛔ LO QUE ESTE IVT APAGA, declarado: hasta hoy este era el UNICO arnes del camino de guardado que
         compilaba contra la superficie PUBLICA sola, o sea un testigo pasivo de que NpcRecordOverride +
         NpcRecordOverrideApplier + SaveContext alcanzan sin Friend. Con el IVT, si manana alguien mueve una
         de las tres a Friend, ningun arnes se entera. -->
    <InternalsVisibleTo Include="ChargenFlagSaveGate" />
    <!-- HerenciaAlDibujarGate: mide la tabla de canales (`PresetCategoryFilter.PorCanal` + `Revert`) y la
         hoja de comparacion por valor (`ComparacionPorValor`), las tres Friend A PROPOSITO. Mismo criterio
         que los demas: IVT antes que ampliar la superficie publica. -->
    <InternalsVisibleTo Include="HerenciaAlDibujarGate" />
    <!-- ⛔ RONDA 16 (rev-44): SE QUITO el IVT de PresetCargaEstadoMotorGate que la ronda 14 (rev-37) habia agregado.
         Estaba SOLO para poder llamar `NpcOverrideSaver.SexoEfectivoParaGuardado`, que era Friend; en la ronda 16 esa
         funcion pasa a Public porque es la ENTRADA OBLIGATORIA de una API Public (`NpcRecordOverlay.SombraDeGuardado` ya
         no resuelve el sexo por su cuenta). VERIFICADO: el gate compila sin el IVT. Y esto no apaga nada — al reves,
         DEVUELVE un testigo pasivo: ese gate vuelve a compilar contra la superficie PUBLICA sola, asi que si manana
         alguien vuelve Friend algo de ese camino, se entera al construirlo.
         ⛔⛔ RONDA 18 (DECISIONES 22, rev-49): el IVT SIGUE FUERA y ahora es EL MOTIVO de que
         `SexoEfectivoParaGuardado` no vuelva a Friend. La ronda 18 saco las NUEVE llamadas repetidas a esa funcion
         (`SombraDeGuardado` la resuelve adentro), asi que el motivo de la ronda 16 ya no vale; pero el llamador que
         queda fuera del ensamblado —`PresetCargaEstadoMotorGate.SexoDeLaApp`, que replica el LOAD, no el guardado—
         es justamente este gate SIN IVT. Volverla Friend = devolverle este IVT = apagar ese testigo pasivo a cambio
         de nada. Queda Public y el motivo esta escrito en la propia funcion. -->
    <InternalsVisibleTo Include="SidecarIdentifierProbe" />
    <!-- SlotResolutionProbe: es el unico probe que monta plugins sinteticos REALES con un PluginManager,
         asi que es el unico que puede correr el overload de PRODUCCION de BssliderSidecar.NormalizeKeys
         (el que pasa por LooksmenuLoader.ResolveFormIdentifier). SidecarIdentifierProbe lo ejercita con un
         resolvedor inyectado, que prueba el recorrido pero NO el cableado ni el criterio real de "es light". -->
    <InternalsVisibleTo Include="SlotResolutionProbe" />
    <InternalsVisibleTo Include="ContextoPropioGate" />
    <InternalsVisibleTo Include="OutfitDraftSaveGate" />
    <!-- ⛔ EL ÚNICO TESTIGO de las tres leyes que un editor de borrador aplica sobre el registro:
         ABRIR (¿el borrador manda sobre el disco?), ENSUCIAR (¿contra qué se compara la suciedad?) y
         ABANDONAR (¿el registro que hay bajo este FormID lo puse yo?). Vivían escritas a mano dentro de
         tres Form de WinForms, que no se instancian desde una consola: NO SE PODÍAN MEDIR, y por ese
         hueco pasaron tres defectos que le perdían trabajo al usuario en silencio. `TomaDeBorrador`,
         `ArmoEditor_Form.OverridePristino` y `SintetizarEdidSiFalta` son Friend y así se quedan: el
         testigo LLAMA al sujeto. Ver Tools/BorradorTrasReaperturaGate y
         00-reglas-el-testigo-tiene-que-compartir-el-codigo-del-sujeto. -->
    <InternalsVisibleTo Include="BorradorTrasReaperturaGate" />
    <!-- ⛔ GATE DE BUILD del parser del buscador. Era el flag `filter-selftest` DENTRO de este exe (233
         líneas + una entrada en la ayuda); salió el 2026-08-08 porque un parser de strings da lo mismo en
         toda máquina y no tiene por qué viajar con lo que se distribuye. Llega a NpcFilterQuery / NpcFilterFacet /
         NpcFilterAdvanced_Form.ProbeLayout (Friend) desde afuera, sin volver Public nada.
         Ver Tools/NpcFilterGate y la memoria 00-reglas-self-tests-no-van-en-el-binario. -->
    <InternalsVisibleTo Include="NpcFilterGate" />
    <InternalsVisibleTo Include="DetalleDelRecordGate" />
    <!-- ⛔ EL UNICO GATE QUE EJERCITA NpcFaceGenPacker.PackBatch. Antes no habia ninguno: GateBake corre
         el barrido bake-all, que va por BakeAllRunner y nunca llega al packer, y ChargenFlagSaveGate
         stubea RunChargenBake con Skipped:=True, asi que la fase de pack ni se llama. Se podia invertir
         el predicado de "que archivos exige un bundle" y los 115 arneses seguian verdes. PackBatch,
         PackResult y FaceGenFileSpec son Friend y asi se quedan: el testigo LLAMA al sujeto.
         Ver Tools/PackRequeridosGate y 00-reglas-el-testigo-tiene-que-compartir-el-codigo-del-sujeto. -->
    <InternalsVisibleTo Include="PackRequeridosGate" />
    <!-- ⛔ EL TESTIGO DE LAS DOS CACHES DE ESQUELETO de NpcRenderContext (bytes del BPTD.MODL por raza,
         sockets BSConnectPoint del actor por raza+genero). Compara CACHEADO contra RECALCULAR llamando al
         sujeto real: NpcRenderContext, NpcMountingResolver y NpcMeshCollector son Friend y asi se quedan.
         Un cache que contesta distinto de recalcular es una falla MUDA —la prenda aparece o desaparece de
         la vista previa y nada lo explica—, y ningun otro arnes del repo cruza esa frontera.
         Ver Tools/SocketsCacheGate y 00-reglas-el-testigo-tiene-que-compartir-el-codigo-del-sujeto. -->
    <InternalsVisibleTo Include="SocketsCacheGate" />
    <!-- Mide el costo de EmisionDeArmo y del repintado del selector. Mismo motivo que el de arriba:
         el sujeto (NpcMeshCollector/NpcRenderContext) es Friend, y un probe que se escribiera su
         propia copia mediria su copia. -->
    <InternalsVisibleTo Include="EmisionCostProbe" />
    <!-- Mide el costo de LA FOTO (`FotosDeBorrador.Publicar`, que es `Friend`). Mismo motivo: el gesto
         que se mide es el de produccion; un probe con su propio diccionario mediria su diccionario. -->
    <InternalsVisibleTo Include="FotoCostProbe" />
    <!-- Ejerce las leyes de oclusion (NpcMeshCollector.HeadPartChannelMask / TablaDeDuenosPorSlot /
         SlotsCubiertosPorOtroModelo), que son Friend. Un gate con su propia copia de la ley mediria su
         copia, no la de produccion. -->
    <InternalsVisibleTo Include="OclusionCanonicaGate" />
    <!-- Ejerce la POLITICA del boton "Slots declared by the models..." (SlotsDelModelo.Proponer /
         MascaraAplicada / FueraDeBandaSeOculta), que es Friend porque es decision de producto de esta
         app y no ley del motor. La LEY que si es del motor vive en FO4_Base_Library.SlotsDeLaMalla y es
         publica: el gate la ejerce sin IVT. -->
    <InternalsVisibleTo Include="SlotsDelModeloGate" />
  </ItemGroup>

  <!-- Compiled Papyrus apply-scripts, EMBEDDED in the assembly and extracted to Data\Scripts\ on save
       (NpcApplyScriptEmitter.InstallPex). Embedded rather than copied loose so there is no side folder to
       lose when the app is moved/distributed, and — the real reason — so the .pex can never drift out of
       sync with the app version that emitted the VMAD referencing it: a stale loose .pex would silently
       ignore properties it does not know about, applying nothing and reporting nothing.

       LogicalName is pinned so the lookup does not depend on how MSBuild derives resource names from paths.

       ONLY our two scripts. The native stubs (NiOverride/Overlays/BodyGen) must NEVER ship: a loose .pex
       shadows the BSA/BA2, so ours would replace RaceMenu's / LooksMenu's real implementation.
       See ..\Papyrus\README.md. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Papyrus\pex_sse\NPCM_Manolov_ApplySSE.pex" LogicalName="NpcManager.Papyrus.NPCM_Manolov_ApplySSE.pex" />
    <EmbeddedResource Include="..\Papyrus\pex_fo4\NPCM_Manolov_ApplyFO4.pex" LogicalName="NpcManager.Papyrus.NPCM_Manolov_ApplyFO4.pex" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tools/OverlaySlotGate: self-test del lector de skee64.ini y de las reglas de slot de overlay
         (SseCatalogs es Friend). Mismo criterio que ParityGate en FO4_Base_Library: el gate llega a los
         miembros Friend desde afuera y la superficie que se distribuye no cambia. El test es de PARSEO y
         de I/O sobre archivos que el propio gate escribe ⇒ da lo mismo en toda maquina y no tiene nada
         que hacer viajando en el binario. Ver 00-reglas-self-tests-no-van-en-el-binario. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>OverlaySlotGate</_Parameter1>
    </AssemblyAttribute>
    <!-- Tools/HairTintGateProbe: mide el gate del tinte de pelo (IsHairHeadPart, por TIPO de head part)
         contra la ley del motor (por MATERIAL). Necesita MeshCandidate y NpcMaterialResolver, que son
         Friend y asi se quedan. Mismo criterio que OverlaySlotGate: el testigo LLAMA al sujeto en vez de
         re-transcribirlo. Ver 00-reglas-el-testigo-tiene-que-compartir-el-codigo-del-sujeto. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>HairTintGateProbe</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Fija la plataforma del wrapper NATIVO. Va en LOS SEIS proyectos, no solo en los dos que lo
       referencian de verdad: el SDK inyecta el ProjectReference transitivo sin la metadata. Ver el .targets. -->
  <Import Project="..\..\..\DirectXTextWrapper\DirectXTexWrapper.targets" />
  <!-- Avisa si un formulario quedo con COPIA PROPIA de los iconos compartidos. Solo lee; no
       modifica nada. Warning en Debug, error en Release. Ver el comentario del .targets. -->
  <Import Project="..\..\FO4_Base_Library\IconosCompartidos.targets" />
  <!-- La configuracion Publish: es Release con carpeta propia. Sin esto compilaria SIN
       OPTIMIZAR, en verde. Ver el comentario del .targets. -->
  <Import Project="..\..\FO4_Base_Library\ConfiguracionPublish.targets" />
  <!-- Avisa (Debug/Release) o CORTA (Publish) si el .vbproj se quedo sin el <EmbeddedResource> de los
       .pex de Papyrus. Lo borro el disenador de VS el 2026-08-18 y la app quedo 4 dias fallando el Save
       ESP despues de escribir el .esp, con el build en verde. Ver el comentario del .targets. -->
  <Import Project="..\Papyrus\PexEmbebido.targets" />

  <!-- Licencias. GPL-3 §4/§5 exige que el texto acompañe al binario, y MIT/Apache-2.0 exigen que
       viaje el aviso de cada componente. Se copian al output para que el paquete salga completo:
       CopyPublish.bat las toma de ahí y CORTA si falta alguna. Ver THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE_CREDITS.txt" Link="LICENSE_CREDITS.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Explicitas, NO un wildcard: `licenses\*.txt` no puede fallar, y un paquete sin los
         textos se distribuiria en infraccion en verde. Un Content que apunta a un archivo
         inexistente da MSB3030 y pone el build en ROJO. Si se agrega una familia de licencia
         nueva, va aca Y en el for de CopyPublish.bat. -->
    <Content Include="..\licenses\MIT.txt" Link="licenses\MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\Apache-2.0.txt" Link="licenses\Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\MPL-2.0.txt" Link="licenses\MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\licenses\GLFW-zlib.txt" Link="licenses\GLFW-zlib.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
