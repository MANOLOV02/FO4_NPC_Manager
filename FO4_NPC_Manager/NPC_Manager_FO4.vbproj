<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>FO4_NPC_Manager</RootNamespace>
    <StartupObject>FO4_NPC_Manager.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="FO4_Base_Library" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FO4_Base_Library\FO4_Base_Library.vbproj" />
  </ItemGroup>

  <!-- El CLI headless (FO4_FaceTint_CLI) llama FaceGenBuilder.BuildCharGen + NpcMaterialResolver
       (Friend) para bakear NIF+texturas sin GUI/GL. Sin cambiar la visibilidad del API interno. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FO4_FaceTint_CLI" />
    <!-- Sonda de medición (Tools/, sólo lectura): ejercita NpcTemplateMaterializer.MakeCategoryOwn REAL
         sobre el load order en vez de reimplementar su lógica. Ver Tools/TemplateMaterializeProbe. -->
    <InternalsVisibleTo Include="TemplateMaterializeProbe" />
    <!-- ⛔ GATE DE BUILD del parser del buscador. Era el flag `filter-selftest` DENTRO de este exe (233
         líneas + una entrada en la ayuda); salió el 2026-08-08 porque un parser de strings da lo mismo en
         toda máquina y no tiene por qué viajar con lo que se distribuye. Llega a NpcFilterQuery / NpcFilterFacet /
         NpcFilterAdvanced_Form.ProbeLayout (Friend) desde afuera, sin volver Public nada.
         Ver Tools/NpcFilterGate y la memoria 00-reglas-self-tests-no-van-en-el-binario. -->
    <InternalsVisibleTo Include="NpcFilterGate" />
  </ItemGroup>

  <!-- Compiled Papyrus apply-scripts, EMBEDDED in the assembly and extracted to Data\Scripts\ on save
       (NpcApplyScriptEmitter.InstallPex). Embedded rather than copied loose so there is no side folder to
       lose when the app is moved/distributed, and — the real reason — so the .pex can never drift out of
       sync with the app version that emitted the VMAD referencing it: a stale loose .pex would silently
       ignore properties it does not know about, applying nothing and reporting nothing.

       LogicalName is pinned so the lookup does not depend on how MSBuild derives resource names from paths.

       ONLY our two scripts. The native stubs (NiOverride/Overlays/BodyGen) must NEVER ship: a loose .pex
       shadows the BSA/BA2, so ours would replace RaceMenu's / LooksMenu's real implementation.
       See ..\Papyrus\README.md. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Papyrus\pex_sse\NPCM_Manolov_ApplySSE.pex" LogicalName="NpcManager.Papyrus.NPCM_Manolov_ApplySSE.pex" />
    <EmbeddedResource Include="..\Papyrus\pex_fo4\NPCM_Manolov_ApplyFO4.pex" LogicalName="NpcManager.Papyrus.NPCM_Manolov_ApplyFO4.pex" />
  </ItemGroup>
</Project>
