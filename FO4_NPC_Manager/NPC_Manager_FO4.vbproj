<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Configurations>Debug;Release;Publish</Configurations>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>FO4_NPC_Manager</RootNamespace>
    <StartupObject>FO4_NPC_Manager.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="FO4_Base_Library" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FO4_Base_Library\FO4_Base_Library.vbproj" />
  </ItemGroup>

  <!-- ⛔ LINKEADO, NO REFERENCIADO. CrashReport se compila DENTRO de este exe a proposito: tiene que poder
       reportar que FO4_Base_Library.dll no cargo, y desde adentro de esa lib se caeria con ella. Misma
       fuente que usa Wardrobe_Manager. Ver ..\..\FO4_Base_Library\Shared\CrashReport.vb y Program.Main. -->
  <ItemGroup>
    <Compile Include="..\..\FO4_Base_Library\Shared\CrashReport.vb" Link="CrashReport.vb" />
  </ItemGroup>

  <!-- El CLI headless (FO4_FaceTint_CLI) llama FaceGenBuilder.BuildCharGen + NpcMaterialResolver
       (Friend) para bakear NIF+texturas sin GUI/GL. Sin cambiar la visibilidad del API interno. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FO4_FaceTint_CLI" />
    <!-- Sonda de medición (Tools/, sólo lectura): ejercita NpcTemplateMaterializer.MakeCategoryOwn REAL
         sobre el load order en vez de reimplementar su lógica. Ver Tools/TemplateMaterializeProbe. -->
    <InternalsVisibleTo Include="TemplateMaterializeProbe" />
    <InternalsVisibleTo Include="SidecarIdentifierProbe" />
    <!-- SlotResolutionProbe: es el unico probe que monta plugins sinteticos REALES con un PluginManager,
         asi que es el unico que puede correr el overload de PRODUCCION de BssliderSidecar.NormalizeKeys
         (el que pasa por LooksmenuLoader.ResolveFormIdentifier). SidecarIdentifierProbe lo ejercita con un
         resolvedor inyectado, que prueba el recorrido pero NO el cableado ni el criterio real de "es light". -->
    <InternalsVisibleTo Include="SlotResolutionProbe" />
    <!-- ⛔ GATE DE BUILD del parser del buscador. Era el flag `filter-selftest` DENTRO de este exe (233
         líneas + una entrada en la ayuda); salió el 2026-08-08 porque un parser de strings da lo mismo en
         toda máquina y no tiene por qué viajar con lo que se distribuye. Llega a NpcFilterQuery / NpcFilterFacet /
         NpcFilterAdvanced_Form.ProbeLayout (Friend) desde afuera, sin volver Public nada.
         Ver Tools/NpcFilterGate y la memoria 00-reglas-self-tests-no-van-en-el-binario. -->
    <InternalsVisibleTo Include="NpcFilterGate" />
  </ItemGroup>

  <!-- Compiled Papyrus apply-scripts, EMBEDDED in the assembly and extracted to Data\Scripts\ on save
       (NpcApplyScriptEmitter.InstallPex). Embedded rather than copied loose so there is no side folder to
       lose when the app is moved/distributed, and — the real reason — so the .pex can never drift out of
       sync with the app version that emitted the VMAD referencing it: a stale loose .pex would silently
       ignore properties it does not know about, applying nothing and reporting nothing.

       LogicalName is pinned so the lookup does not depend on how MSBuild derives resource names from paths.

       ONLY our two scripts. The native stubs (NiOverride/Overlays/BodyGen) must NEVER ship: a loose .pex
       shadows the BSA/BA2, so ours would replace RaceMenu's / LooksMenu's real implementation.
       See ..\Papyrus\README.md. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Papyrus\pex_sse\NPCM_Manolov_ApplySSE.pex" LogicalName="NpcManager.Papyrus.NPCM_Manolov_ApplySSE.pex" />
    <EmbeddedResource Include="..\Papyrus\pex_fo4\NPCM_Manolov_ApplyFO4.pex" LogicalName="NpcManager.Papyrus.NPCM_Manolov_ApplyFO4.pex" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tools/OverlaySlotGate: self-test del lector de skee64.ini y de las reglas de slot de overlay
         (SseCatalogs es Friend). Mismo criterio que ParityGate en FO4_Base_Library: el gate llega a los
         miembros Friend desde afuera y la superficie que se distribuye no cambia. El test es de PARSEO y
         de I/O sobre archivos que el propio gate escribe ⇒ da lo mismo en toda maquina y no tiene nada
         que hacer viajando en el binario. Ver 00-reglas-self-tests-no-van-en-el-binario. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>OverlaySlotGate</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Fija la plataforma del wrapper NATIVO. Va en LOS SEIS proyectos, no solo en los dos que lo
       referencian de verdad: el SDK inyecta el ProjectReference transitivo sin la metadata. Ver el .targets. -->
  <Import Project="..\..\..\DirectXTextWrapper\DirectXTexWrapper.targets" />
  <!-- Avisa si un formulario quedo con COPIA PROPIA de los iconos compartidos. Solo lee; no
       modifica nada. Warning en Debug, error en Release. Ver el comentario del .targets. -->
  <Import Project="..\..\FO4_Base_Library\IconosCompartidos.targets" />
  <!-- La configuracion Publish: es Release con carpeta propia. Sin esto compilaria SIN
       OPTIMIZAR, en verde. Ver el comentario del .targets. -->
  <Import Project="..\..\FO4_Base_Library\ConfiguracionPublish.targets" />
</Project>
