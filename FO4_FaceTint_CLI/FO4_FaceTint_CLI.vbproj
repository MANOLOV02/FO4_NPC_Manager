<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>FO4_FaceTint_CLI</RootNamespace>
    <StartupObject>FO4_FaceTint_CLI.Program</StartupObject>
    <!-- Config_App.LoadConfig usa System.Windows.Forms (MessageBox) + Application.StartupPath,
         y el decode CPU (DirectXTexWrapper, x64 nativo) viene via la libreria. -->
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Console</MyType>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="FO4_Base_Library" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FO4_Base_Library\FO4_Base_Library.vbproj" />
    <!-- App: FaceGenBuilder.BuildCharGen (NIF+texturas, path CPU headless) para el bake batch del CLI. -->
    <ProjectReference Include="..\FO4_NPC_Manager\NPC_Manager_FO4.vbproj" />
  </ItemGroup>

  <!-- ⛔ ACA VIVIA `CopyX64DirectXTexWrapper`, que parcheaba la salida copiando el wrapper x64 ENCIMA del
       x86 que MSBuild acababa de dejar. Describia bien el problema (el .vcxproj se construye Win32 por
       default y en un proceso x64 cada textura DX10 devuelve 0 bytes) pero lo tapaba, y con TRES agujeros:
       el `Condition="Exists(...)"` hacia que, si el x64 no estaba compilado, NO copiara y NO avisara; el
       destino era `$(OutDir)` y no `$(PublishDir)`, asi que en un `publish` no aterrizaba; y solo cubria
       la direccion x64, nunca la x86. Ahora la plataforma se FIJA en el ProjectReference, abajo.
       MEDIDO antes de este cambio: `msbuild NPC_Manager_FO4.vbproj -restore -t:Publish` publicaba el exe
       x64 con el DirectXTexWrapper.dll x86 al lado, en verde. -->

  <!-- Fija la plataforma del wrapper NATIVO. Va en LOS SEIS proyectos, no solo en los dos que lo
       referencian de verdad: el SDK inyecta el ProjectReference transitivo sin la metadata. Ver el .targets. -->
  <Import Project="..\..\..\DirectXTextWrapper\DirectXTexWrapper.targets" />
</Project>
